# NEXUS Console local development configuration.
# Copy this file to .env.local (gitignored) and fill in real values there.
# Never commit an actual token -- see CLAUDE.md section 9.7.

# Base URL of a running NEXUS API (api.py / uvicorn api:app).
VITE_NEXUS_API_BASE_URL=http://127.0.0.1:8000

# Only needed if the backend was started with NEXUS_API_TOKEN configured.
# VITE_* values are embedded into the browser bundle and are not secrets.
# Use this only for a trusted local/demo browser. Do not use a real shared
# or production credential here. Leave unset for backend development mode.
VITE_NEXUS_API_TOKEN=
