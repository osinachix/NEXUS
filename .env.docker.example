# NEXUS Docker Compose environment (Phase 7).
#
# Copy this file to `.env.docker` (gitignored) and fill in real values.
# Never commit `.env.docker`. This file is deliberately separate from the
# repo-root `.env` used by local, non-Docker development (main.py/pytest),
# so the two never collide or get confused with each other.
#
# Usage:
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up --build
#
# Every value below is a placeholder. No real secret is, or should ever be,
# committed to this file.

# --- PostgreSQL (the compose-provided database) -----------------------------
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nexus

# --- NEXUS API ---------------------------------------------------------------
# Required. config.py refuses to start with NEXUS_ENVIRONMENT=production (the
# image's default) and no token -- see config.py's load_config().
NEXUS_API_TOKEN=change-me

# Required. Never logged; read implicitly by the Anthropic SDK (main.py).
ANTHROPIC_API_KEY=your-key-here

# Optional. Defaults to a pinned dated snapshot (see main.py's DEFAULT_MODEL)
# if left unset.
# ANTHROPIC_MODEL=

# Optional. Origins allowed to call this API from a browser (the NEXUS
# Console). Comma-separated, exact-match only (see api.py's CORS section).
NEXUS_CONSOLE_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Process-local rate limiting (see rate_limit.py / SECURITY.md
# Known limitations -- this is per-container, not distributed).
NEXUS_RATE_LIMIT_REQUESTS=60
NEXUS_RATE_LIMIT_WINDOW_SECONDS=60
